# Заголовки для Cloudflare Pages.
# Имена файлов у картинок, видео и шрифтов — это отпечаток содержимого:
# меняется кадр — меняется имя. Значит их можно кэшировать навсегда.
# index.html так кэшировать нельзя: иначе правка не доедет до гостя.

/img/*
  Cache-Control: public, max-age=31536000, immutable

/vid/*
  Cache-Control: public, max-age=31536000, immutable

/font/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
